# En local no hace falta rellenar esto a mano: Vercel + la integración de
# Neon crean la variable de conexión automáticamente al conectar la base de
# datos al proyecto. Esto es solo para pruebas en tu propio ordenador.
DATABASE_URL=postgres://usuario:contraseña@host/basededatos?sslmode=require

# Token secreto para poder llamar una vez a GET /api/seed?token=... y cargar
# los datos reales del equipo. Ponlo tú (cualquier cadena larga al azar) como
# variable de entorno en Vercel — no hace falta guardarlo aquí.
SEED_TOKEN=elige-un-token-largo-y-aleatorio
